# Coach Sport — Environment variables template
# Copy this file to `.env` (dev) or set these as environment variables on Netlify/Render.
# See DEPLOY.md for the complete deployment guide.

# Database (Neon Postgres)
# Required for production. If omitted, falls back to in-memory store (dev only).
# Get this from https://console.neon.tech -> your project -> connection string
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/dbname?sslmode=require

# JWT signing secret
# Required. Generate with: openssl rand -hex 32
# Used to sign access tokens (15min) and refresh tokens (30d)
JWT_SECRET=replace-with-32-char-random-string

# Stripe (optional, only for subscriptions)
# Get from https://dashboard.stripe.com/apikeys
# Format: starts with sk_test_ (test mode) or sk_live_ (live mode)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE

# Webhook signing secret - set AFTER creating the webhook endpoint
# https://dashboard.stripe.com/webhooks
# Format: starts with whsec_
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Price ID for the Pro plan checkout
# https://dashboard.stripe.com/products -> create a recurring product -> copy price ID
# Format: starts with price_
STRIPE_PRICE_ID_PRO=YOUR_STRIPE_PRICE_ID_HERE

# CORS (Render only - when API and frontend are on different domains)
# The URL of your frontend. Used to allow CORS in the Express server.
# Example: https://coach-sport-web.onrender.com
CORS_ORIGIN=
